{
  "name": "noetharamobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "check": "npx expo-doctor@latest",
    "check:sdk": "npx expo install --check",
    "check:ios": "expo export --platform ios --output-dir /tmp/noethara-ios-smoke-test --clear",
    "start:dev": "expo start --dev-client",
    "start:dev:tunnel": "expo start --dev-client --tunnel",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android"
  },
  "dependencies": {
    "expo": "^58.0.0",
    "expo-linear-gradient": "~58.0.3",
    "expo-status-bar": "~58.0.3",
    "@expo/vector-icons": "^15.0.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "@supabase/supabase-js": "^2.79.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "expo-web-browser": "~58.0.6",
    "expo-linking": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "react-native-markdown-display": "^7.0.2",
    "react-native-webview": "14.0.1",
    "expo-font": "~58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
